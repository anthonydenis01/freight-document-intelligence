    "/shipments/{shipment_id}/actions": {
      "get": {
        "summary": "Proposed follow-up actions with draft emails",
        "operationId": "list_actions_shipments__shipment_id__actions_get",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
