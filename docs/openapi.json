    "/actions/{action_id}/approve": {
      "post": {
        "summary": "One-click human approval of a follow-up action",
        "operationId": "approve_follow_up_actions__action_id__approve_post",
        "parameters": [
          {
            "name": "action_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Action Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
