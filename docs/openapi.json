{
  "openapi": "3.1.0",
  "info": {
    "title": "Freight Document Intelligence API",
    "description": "Evidence-backed freight-document intelligence engine: structured extraction, cited Q&A, cross-document reconciliation and compliance checks over shipment document packs. Decision-support only \u2014 nothing is filed without a recorded human approval. All bundled data is synthetic.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health + corpus size",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/shipments": {
      "get": {
        "summary": "List shipment packs",
        "operationId": "list_shipments_shipments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/shipments/{shipment_id}/fields": {
      "get": {
        "summary": "Extracted fields with provenance",
        "operationId": "get_fields_shipments__shipment_id__fields_get",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Shipment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "summary": "Cited Q&A across the document packs",
        "operationId": "ask_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/shipments/{shipment_id}/reconcile": {
      "post": {
        "summary": "Run the 12 cross-document checks",
        "operationId": "reconcile_shipments__shipment_id__reconcile_post",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
