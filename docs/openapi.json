    "/shipments/{shipment_id}/review": {
      "post": {
        "summary": "Record a named human approval",
        "operationId": "review_shipments__shipment_id__review_post",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Shipment Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
