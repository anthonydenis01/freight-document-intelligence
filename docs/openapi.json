    "/packs": {
      "post": {
        "summary": "Upload a new shipment pack (PDFs)",
        "operationId": "upload_pack_packs_post",
        "parameters": [
          {
            "name": "shipment_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Shipment Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_pack_packs_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
