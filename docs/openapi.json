            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/shipments/{shipment_id}/report": {
      "get": {
        "summary": "Full audit report (reconciliation + compliance)",
